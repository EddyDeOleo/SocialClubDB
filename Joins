-- 👤 PERSONA 4
--------------------------------------------------------------------------------

-- 1️⃣ NATURAL JOIN
SELECT evento_id, nombre_evento, socio_id, estado_inscripcion
FROM Eventos NATURAL JOIN Inscripciones;

-- 2️⃣ USING
SELECT evento_id, calificacion, comentarios_encuesta, nombre_evento
FROM EncuestasSatisfaccion JOIN Eventos USING (evento_id);

-- 3️⃣ JOIN + ON
SELECT m.mensaje_id, u.nombre_usuario AS remitente, u2.nombre_usuario AS destinatario
FROM Mensajes m
JOIN UsuariosSistema u ON m.remitente_id = u.usuario_id
JOIN UsuariosSistema u2 ON m.destinatario_id = u2.usuario_id;

-- 4️⃣ SELF-JOIN
SELECT e1.nombre_evento AS evento1, e2.nombre_evento AS evento2
FROM Eventos e1 JOIN Eventos e2 ON e1.evento_id < e2.evento_id;

-- 5️⃣ NON-EQUIJOIN
SELECT e.nombre_evento, e.costo_evento, p.pago_id, p.monto_pago
FROM Eventos e JOIN Pagos p ON e.costo_evento <= p.monto_pago;

-- 6️⃣ OUTER JOIN
SELECT i.inscripcion_id, i.estado_inscripcion, p.monto_pago
FROM Inscripciones i LEFT JOIN Pagos p ON i.pago_id = p.pago_id;

