-- 👤 PERSONA 5
--------------------------------------------------------------------------------

-- 1️⃣ NATURAL JOIN
SELECT reserva_id, socio_id, nombre_instalacion, estado_reserva
FROM Reservas NATURAL JOIN Instalaciones;

-- 2️⃣ USING
SELECT reserva_id, socio_id, fecha_registro, estado_reserva
FROM HistorialSocio JOIN Reservas USING (reserva_id);

-- 3️⃣ JOIN + ON
SELECT m.mantenimiento_id, i.nombre_instalacion, m.tipo_mantenimiento
FROM Mantenimientos m JOIN Instalaciones i ON m.instalacion_id = i.instalacion_id;

-- 4️⃣ SELF-JOIN
SELECT i1.nombre_instalacion AS instalacion1, i2.nombre_instalacion AS instalacion2
FROM Instalaciones i1 JOIN Instalaciones i2 ON i1.instalacion_id < i2.instalacion_id;

-- 5️⃣ NON-EQUIJOIN
SELECT e.evaluacion_id, e.calificacion, i.nombre_instalacion
FROM EvaluacionesInstalacion e JOIN Instalaciones i ON e.instalacion_id = i.instalacion_id
WHERE e.calificacion > 3;

-- 6️⃣ OUTER JOIN
SELECT r.reserva_id, r.estado_reserva, h.detalle_historial
FROM Reservas r LEFT JOIN HistorialSocio h ON r.reserva_id = h.reserva_id;
